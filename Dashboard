<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>FFIEC 031 – Private Credit Exposure Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <style>
    :root {
      --bg: #0f172a;
      --card: #111827;
      --primary: #e5e7eb;
      --secondary: #9ca3af;
      --accent: #3b82f6;
      --border: #1f2933;
      --row-alt: #0b1220;
    }

    body {
      margin: 0;
      padding: 24px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                   Roboto, "Helvetica Neue", Arial, sans-serif;
      background: var(--bg);
      color: var(--primary);
    }

    .container {
      max-width: 1400px;
      margin: auto;
      background: var(--card);
      padding: 28px 32px 36px;
      border-radius: 10px;
      box-shadow: 0 12px 30px rgba(0,0,0,0.5);
    }

    h1 {
      margin: 0 0 6px 0;
      font-size: 26px;
      font-weight: 600;
    }

    .subtitle {
      color: var(--secondary);
      margin-bottom: 20px;
      font-size: 14px;
    }

    .controls {
      display: flex;
      gap: 12px;
      align-items: center;
      margin-bottom: 20px;
    }

    input[type="file"] {
      font-size: 14px;
      color: var(--secondary);
    }

    button {
      background: var(--accent);
      color: #ffffff;
      border: none;
      padding: 9px 16px;
      border-radius: 6px;
      font-size: 14px;
      cursor: pointer;
    }

    .status {
      margin-top: 10px;
      font-size: 13px;
      color: var(--secondary);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 22px;
      font-size: 14px;
    }

    thead th {
      background: #020617;
      color: var(--primary);
      padding: 12px 10px;
      text-align: left;
      font-weight: 500;
      border-bottom: 1px solid var(--border);
    }

    tbody tr:nth-child(even) {
      background: var(--row-alt);
    }

    tbody tr:hover {
      background: #020617;
    }

    td {
      border-bottom: 1px solid var(--border);
      padding: 10px;
    }

    td.number {
      text-align: right;
      font-family: Consolas, "Courier New", monospace;
      color: #d1d5db;
    }

    td.percent {
      text-align: right;
      font-weight: 600;
      color: var(--accent);
    }

    .charts {
      margin-top: 48px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .chart-card h2 {
      margin-bottom: 12px;
      font-size: 18px;
      font-weight: 600;
    }
  </style>
</head>

<body>
<div class="container">

  <h1>Private Credit Exposure</h1>
  <div class="subtitle">
    FFIEC 031 · Loans to Business Credit Intermediaries (Private Credit as % of Tier 1 Capital)
  </div>

  <div class="controls">
    <input type="file" id="pdfInput" multiple accept=".pdf,.html,.htm" />
    <button onclick="processFiles()">Process Files</button>
  </div>

  <div id="status" class="status"></div>

  <table>
    <thead>
      <tr>
        <th>Bank</th>
        <th>Description</th>
        <th>Unused Commitments<br>(RCFDPV13)</th>
        <th>Outstanding Loans<br>(RCFDPV06)</th>
        <th>Tier 1 Capital<br>(RCFA8274)</th>
        <th>% Tier 1</th>
      </tr>
    </thead>
    <tbody id="tableBody"></tbody>
  </table>

  <div class="charts">
    <div class="chart-card">
      <h2>Private Credit as a % of Tier 1 Capital by Bank</h2>
      <canvas id="barChartTotalPct"></canvas>
    </div>

    <div class="chart-card">
      <h2>Outstanding Loans (RCFDPV06) as a % of Tier 1 Capital</h2>
      <canvas id="barChartLoansPct"></canvas>
    </div>
  </div>

</div>

<!-- ✅ REQUIRED LIBRARIES -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
pdfjsLib.GlobalWorkerOptions.workerSrc =
  'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

/* ---------- bank name cleanup ---------- */
const BANK_MAP = [
  ['CITIBANK', 'Citi'],
  ['GOLDMAN', 'Goldman Sachs'],
  ['BANK OF AMERICA', 'Bank of America'],
  ['JPMORGAN', 'JPMorgan'],
  ['JP MORGAN', 'JPMorgan'],
  ['WELLS FARGO', 'Wells Fargo'],
  ['MORGAN STANLEY', 'Morgan Stanley'],
  ['CAPITAL ONE', 'Capital One'],
  ['COMERICA', 'Comerica'],
  ['EAST WEST', 'East West'],
  ['FIFTH THIRD', 'Fifth Third'],
  ['HUNTINGTON', 'Huntington'],
  ['PNC', 'PNC'],
  ['REGIONS', 'Regions'],
  ['TRUIST', 'Truist'],
  ['VALLEY NATIONAL', 'Valley National']
];

function shortBankName(raw) {
  const u = raw.toUpperCase();
  for (const [k, v] of BANK_MAP) {
    if (u.includes(k)) return v;
  }
  return raw.replace(/,?\s*N\.A\.?/gi, '').replace(/,?\s*BANK/gi, '').trim();
}

/* ---------- helpers ---------- */
function parseNumber(str) {
  if (!str) return null;
  const cleaned = str.replace(/[^\d\-(),]/g, '').replace(/,/g, '');
  if (!cleaned) return null;
  const neg = /^\(.*\)$/.test(cleaned);
  const n = Number(cleaned.replace(/[()]/g, ''));
  return isNaN(n) ? null : (neg ? -n : n);
}

function safeXY(i) {
  return i.transform ? { x: i.transform[4], y: i.transform[5] } : null;
}

function findNumberToRight(items, codeItem) {
  const p = safeXY(codeItem);
  if (!p) return null;
  return items
    .map(i => ({ i, p: safeXY(i) }))
    .filter(o => o.p && Math.abs(o.p.y - p.y) <= 3 && o.p.x > p.x)
    .sort((a,b) => a.p.x - b.p.x)
    .map(o => parseNumber(o.i.str))
    .find(v => v !== null) ?? null;
}

function extractInstitution(items) {
  const t = items.map(i => i.str).join(' ');
  const m = t.match(/Institution Name\s+([A-Z0-9 ,.'-]+)/i);
  return m ? m[1].trim() : 'Unknown';
}

/* ---------- chart utilities ---------- */
function valueToColor(v, min, max) {
  const t = (v - min) / (max - min || 1);
  const r = Math.round(180 + 60 * t);
  const g = Math.round(180 * (1 - t));
  return `rgb(${r}, ${g}, 60)`;
}

let totalChart, loansChart;
const chartData = [];      // { bank, totalPct }
const loansOnlyData = [];  // { bank, loansPct }

/* ---------- main ---------- */
async function processFiles() {
  const files = document.getElementById('pdfInput').files;
  const tbody = document.getElementById('tableBody');
  const status = document.getElementById('status');

  tbody.innerHTML = '';
  chartData.length = 0;
  loansOnlyData.length = 0;

  for (const file of files) {
    status.textContent = `Processing ${file.name}…`;
    const dotIdx = file.name.lastIndexOf('.');
    const ext = dotIdx !== -1 ? file.name.slice(dotIdx + 1).toLowerCase() : '';
    if (ext === 'html' || ext === 'htm') {
      await processSingleHTML(file, tbody);
    } else {
      await processSinglePDF(file, tbody);
    }
  }

  renderCharts();
  status.textContent = 'Completed';
}

async function processSinglePDF(file, tbody) {
  const pdf = await pdfjsLib.getDocument(await file.arrayBuffer()).promise;
  const res = { institution:'', RCFDPV13:null, RCFDPV06:null, RCFA8274:null };

  const p1 = await pdf.getPage(1);
  const t1 = await p1.getTextContent({ normalizeWhitespace:true, disableCombineTextItems:true });
  res.institution = extractInstitution(t1.items);

  for (let p=1; p<=pdf.numPages; p++) {
    const page = await pdf.getPage(p);
    const text = await page.getTextContent({ normalizeWhitespace:true, disableCombineTextItems:true });
    for (const it of text.items) {
      if (['RCFDPV13','RCFDPV06','RCFA8274'].includes(it.str) && res[it.str]===null) {
        res[it.str] = findNumberToRight(text.items, it);
      }
    }
  }

  // Derived percentages
  let totalPct = null; // (RCFDPV13 + RCFDPV06) / RCFA8274
  let loansPct = null; // RCFDPV06 / RCFA8274

  if (res.RCFA8274 && res.RCFA8274 !== 0) {
    if (res.RCFDPV13 !== null && res.RCFDPV06 !== null) {
      totalPct = ((res.RCFDPV13 + res.RCFDPV06) / res.RCFA8274) * 100;
    }
    if (res.RCFDPV06 !== null) {
      loansPct = (res.RCFDPV06 / res.RCFA8274) * 100;
    }
  }

  const bank = shortBankName(res.institution);

  tbody.insertAdjacentHTML('beforeend', `
    <tr>
      <td>${bank}</td>
      <td>Loans to business credit intermediaries</td>
      <td class="number">${res.RCFDPV13?.toLocaleString() ?? 'N/A'}</td>
      <td class="number">${res.RCFDPV06?.toLocaleString() ?? 'N/A'}</td>
      <td class="number">${res.RCFA8274?.toLocaleString() ?? 'N/A'}</td>
      <td class="percent">${Number.isFinite(totalPct) ? totalPct.toFixed(2)+'%' : 'N/A'}</td>
    </tr>
  `);

  if (Number.isFinite(totalPct)) chartData.push({ bank, value: totalPct });
  if (Number.isFinite(loansPct)) loansOnlyData.push({ bank, value: loansPct });
}

async function processSingleHTML(file, tbody) {
  const html = await file.text();
  const parser = new DOMParser();
  const doc = parser.parseFromString(html, 'text/html');

  const res = { institution: '', RCFDPV13: null, RCFDPV06: null, RCFA8274: null };

  // Extract institution name from common FFIEC HTML patterns:
  // 1. A cell/element that follows "Institution Name" text
  // 2. <title> tag containing the institution name
  const allText = doc.body ? doc.body.innerText || doc.body.textContent : '';
  const instMatch = allText.match(/Institution\s+Name[:\s]+([^\n<>]+)/i);
  if (instMatch) {
    res.institution = instMatch[1].trim();
  } else {
    const titleEl = doc.querySelector('title');
    res.institution = titleEl ? titleEl.textContent.trim() : file.name.replace(/\.html?$/i, '');
  }

  // Walk every table row looking for MDRM code cells followed by a value cell.
  // FFIEC HTML tables typically have rows like:
  //   <td>RCFDPV13</td> ... <td>12345</td>
  const TARGET_CODES = new Set(['RCFDPV13', 'RCFDPV06', 'RCFA8274']);

  doc.querySelectorAll('tr').forEach(row => {
    const cells = Array.from(row.querySelectorAll('td, th'));
    cells.forEach((cell, idx) => {
      const code = cell.textContent.trim().toUpperCase();
      if (TARGET_CODES.has(code) && res[code] === null) {
        // The value is usually in the next non-empty cell in the same row
        for (let j = idx + 1; j < cells.length; j++) {
          const val = parseNumber(cells[j].textContent.trim());
          if (val !== null) {
            res[code] = val;
            break;
          }
        }
      }
    });
  });

  // Fallback: scan raw text for patterns like "RCFDPV13  12,345"
  if (res.RCFDPV13 === null || res.RCFDPV06 === null || res.RCFA8274 === null) {
    for (const code of TARGET_CODES) {
      if (res[code] !== null) continue;
      const re = new RegExp(code + '[\\s\\t]+([\\d,()\\-]+)', 'i');
      const m = allText.match(re);
      if (m) res[code] = parseNumber(m[1]);
    }
  }

  // Derived percentages
  let totalPct = null;
  let loansPct = null;

  if (res.RCFA8274 && res.RCFA8274 !== 0) {
    if (res.RCFDPV13 !== null && res.RCFDPV06 !== null) {
      totalPct = ((res.RCFDPV13 + res.RCFDPV06) / res.RCFA8274) * 100;
    }
    if (res.RCFDPV06 !== null) {
      loansPct = (res.RCFDPV06 / res.RCFA8274) * 100;
    }
  }

  const bank = shortBankName(res.institution);

  tbody.insertAdjacentHTML('beforeend', `
    <tr>
      <td>${bank}</td>
      <td>Loans to business credit intermediaries</td>
      <td class="number">${res.RCFDPV13?.toLocaleString() ?? 'N/A'}</td>
      <td class="number">${res.RCFDPV06?.toLocaleString() ?? 'N/A'}</td>
      <td class="number">${res.RCFA8274?.toLocaleString() ?? 'N/A'}</td>
      <td class="percent">${Number.isFinite(totalPct) ? totalPct.toFixed(2)+'%' : 'N/A'}</td>
    </tr>
  `);

  if (Number.isFinite(totalPct)) chartData.push({ bank, value: totalPct });
  if (Number.isFinite(loansPct)) loansOnlyData.push({ bank, value: loansPct });
}

function renderCharts() {
  // Destroy if redrawing
  if (totalChart) totalChart.destroy();
  if (loansChart) loansChart.destroy();

  // Sort both datasets by their own values (descending)
  const sortedTotal = [...chartData].sort((a,b) => b.value - a.value);
  const sortedLoans = [...loansOnlyData].sort((a,b) => b.value - a.value);

  // Helper to compute color range
  function buildConfig(canvasId, sortedData, labelSuffix='%') {
    const values = sortedData.map(d => d.value);
    const max = values.length ? Math.max(...values) : 1;
    const min = values.length ? Math.min(...values) : 0;

    return {
      el: document.getElementById(canvasId),
      data: {
        labels: sortedData.map(d => d.bank),
        datasets: [{
          data: values,
          backgroundColor: values.map(v => valueToColor(v, min, max)),
          borderRadius: 4
        }]
      },
      options: {
        plugins: { legend: { display:false } },
        scales: {
          y: {
            beginAtZero:true,
            grid:{ color:'#1f2933' },
            ticks:{ color:'#e5e7eb', callback:v=>v + labelSuffix }
          },
          x: {
            grid:{ display:false },
            ticks:{ color:'#e5e7eb' }
          }
        }
      }
    };
  }

  // Render total % chart
  const totalCfg = buildConfig('barChartTotalPct', sortedTotal, '%');
  totalChart = new Chart(totalCfg.el, {
    type: 'bar',
    data: totalCfg.data,
    options: totalCfg.options
  });

  // Render loans-only % chart
  const loansCfg = buildConfig('barChartLoansPct', sortedLoans, '%');
  loansChart = new Chart(loansCfg.el, {
    type: 'bar',
    data: loansCfg.data,
    options: loansCfg.options
  });
}
</script>

</body>
</html>
